{
  "name": "attendance-portal-mock-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stateful in-memory mock for the Attendance Portal API. Lets frontend-only teams build against a realistic backend during the hackathon.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "prism": "prism mock ../api-reference.yaml --port 4011 --dynamic"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.10.0",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
